---
import { site } from '../data/site'
import '../styles/global.css'

import NiiLogo from '../assets/nii.svg'
import shift6 from '../assets/shift-6.webp'

import { Copyright } from 'lucide-astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = site.name,
  description = `${site.name} is a new electronic music project.`
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og.png', Astro.site)

const sameAs = [...site.socials.map((s) => s.href), site.github]
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: site.name,
  url: Astro.site?.toString(),
  genre: ['Electro', 'House', 'Future bass', 'Electropop'],
  email: site.bookingEmail,
  sameAs
}

const nav = [
  { label: 'About', href: '/#about' },
  { label: 'Releases', href: '/#releases' },
  { label: 'Contact', href: '/#contact' }
]
---

<!doctype html>
<html lang="en" class="bg-plum-deep scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4a3b52" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <link
      rel="preload"
      href="/fonts/recursive-black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fogtwo-no5.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body class="relative">
    <header class="bg-plum text-peach print:hidden absolute w-full">
      <div class="mx-auto flex max-w-7xl flex-wrap justify-center sm:justify-between items-center gap-x-4 sm:gap-x-8 gap-y-2 py-3 sm:px-10">
        <div class="max-sm:w-full flex justify-center">
          <a
            href="/"
            class="flex min-h-11 min-w-11 items-center justify-center"
            title={site.name}
          >
            <NiiLogo class={'h-10 w-10 fill-peach'} />
          </a>
        </div>
        <nav aria-label="Primary">
          <ul class="flex flex-wrap justify-center items-center gap-x-4 sm:gap-x-6 gap-y-3 text-xs tracking-[0.14em] uppercase">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-10 items-center underline-offset-4 hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a
                href="/epk"
                class="inline-flex items-center border border-peach px-2 py-0.5 hover:bg-peach hover:text-plum"
              >
                EPK
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="bg-plum-deep text-peach print:hidden">
      <div class="mx-auto max-w-7xl px-5 py-14 md:px-10">
        <p
          class="font-logo text-transparent text-[13vw] leading-[0.85] font-black tracking-tight md:text-[7rem] bg-clip-text bg-cover bg-center"
          style={`background-image: url(${shift6.src});`}
        >
          {site.name}
        </p>
        <div class="mt-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-6 text-xs tracking-[0.14em] uppercase">
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            <li>
              <a href={site.github} class="underline-offset-4 hover:underline">
                GitHub
              </a>
            </li>
          </ul>
          <p class="opacity-70 inline-flex items-center-safe">
            <Copyright class="size-3.5 mr-2 mt-1" aria-hidden="true" />
            2026 {site.name} · All signals reserved
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
